% 中文版的篇章层级与英文版共用 memoir 样式，但结构标签与中文标题字号需要单独覆盖。
% Part 页使用中文序数；六字标题在 300pt 版心内以 40pt 单行排下，并保留上游的颜色与字重。
\renewcommand*{\thepart}{\zhnum{part}}
\renewcommand*{\parttitlefont}{\normalfont\fontsize{40pt}{48pt}\selectfont\bfseries\color{OLPcolor}}
\renewcommand*{\chaptitlefont}{\normalfont\fontsize{36pt}{42pt}\selectfont\bfseries\color{OLPcolor}}
\renewcommand*{\printpartname}{\partnamefont 第\thepart 部分}
\renewcommand*{\partnamenum}{}
\renewcommand*{\printpartnum}{}
% 章首按中文语序显示「第 1 章」；进入附录后仍显示「附录 A」。
\renewcommand*{\printchaptername}{%
  \chapnamefont
  \ifanappendix\appendixname\space\thechapter\else 第\thechapter 章\fi}
\renewcommand*{\chapternamenum}{}
\renewcommand*{\printchapternum}{}
