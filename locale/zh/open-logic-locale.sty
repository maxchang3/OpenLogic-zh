% 许可证等样板文字
\renewcommand*{\ollicensetext}[3]{\textit{#1} 由 #2 以 #3 许可发布。}
% babel 26（TeXLive 2026）的 \setlocalecaption 把 caption 宏定义为 \bbl@ensure@<lang>{...} 包装器；当这类宏出现在 \href 的 URL 参数里时，hyperref 的 \hyper@normalise 用 \edef 扫描 URL，与该包装器交互导致无限递归（input stack size）；英文版恰好展开为纯文本所以不触发；因此这里把所有会进入 \href（尤其 URL 位置）的名字宏显式覆盖为纯文本。
% 覆盖必须在 \selectlanguage{chinese}（\AtBeginDocument）之后执行，否则 \captionschinese 会把名字宏重新定义为 \bbl@ensure@chinese 包装
\AtBeginDocument{%
  \def\OLTlinkname{https://github.com/OpenLogicProject/OpenLogic}%
  \def\OLTname{《开放逻辑读本》}%
  \def\OLPname{Open Logic Project}%
  \def\licensename{知识共享署名 4.0 国际许可协议}%
}
% 样板宏：不再引用 babel caption 宏（纯文本，避免上述递归）
\renewcommand*{\oluselicensetext}{本书基于 \textit{\href{\OLTlinkname}{\OLTname}} 中由 \href{http://openlogicproject.org/}{\OLPname} 编写的材料，并在 \href{http://creativecommons.org/licenses/by/4.0/}{\licensename} 下使用。}
\renewcommand*{\olshortlicensetext}[1]{\textit{\href{\OLTlinkname}{\jobname}} 由 #1 编纂，以 \href{http://creativecommons.org/licenses/by/4.0/}{CC--BY} 许可发布。}
\renewcommand*{\olshortuselicensetext}[2]{\textit{#1} 由 #2 基于 \href{http://openlogicproject.org/}{OLP} / \href{http://creativecommons.org/licenses/by/4.0/}{CC--BY} 编纂。}
% 版权页（第 5 页）其他段落的中文版：致谢/插图/排版说明/版本说明（机构名保留英文，用户 2026-08-15 定案；\olbookrevision 不用 gitinfo2 的 \gitAbbrevHash/\gitAuthorDate——缺 gitHeadInfo.gin 会输出 None）
\renewcommand*{\olacknowledgements}{Open Logic Project 谨此感谢卡尔加里大学教学与学习研究所（Taylor Institute of Teaching and Learning）与阿尔伯塔省开放教育资源计划（ABOER Initiative）的慷慨支持，该计划得益于阿尔伯塔省政府（Alberta government）的投入。}
